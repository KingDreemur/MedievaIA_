OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Banco na nuvem (Neon, Supabase): cole a connection string completa.
# Tem prioridade sobre as variaveis DB_* abaixo.
